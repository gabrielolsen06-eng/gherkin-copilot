# GitLab CI: runs every scenario on each push and keeps the results.
# Created by `gherkin-copilot init --ci gitlab`.
#
# It runs in Playwright's own Docker image, which already contains the browsers, so the
# pipeline downloads none. Keep the image version the same as playwright in requirements.lock.
#
# Behind Artifactory:
# - set PIP_INDEX_URL as a CI/CD variable (Settings > CI/CD > Variables) to your Artifactory
#   PyPI address; pip uses it automatically, and the hash checks still apply;
# - if your runners pull Docker images through Artifactory, put its registry in front of the
#   image name (whoever looks after your GitLab runners will know the prefix).

acceptance-tests:
  image: mcr.microsoft.com/playwright/python:v1.63.0-noble
  # The image's Python is made for this: the container is thrown away after each job, so
  # packages go straight into it (the image has no venv module anyway).
  script:
    - python -m pip install --require-hashes -r requirements.lock
    - python -m pytest --junitxml=reports/junit.xml --cucumberjson=reports/cucumber.json --output=reports/artifacts --screenshot=only-on-failure --tracing=retain-on-failure
  # Once gherkin-copilot is in your Artifactory, add these to `script` (before pytest) to fail
  # the pipeline when a scenario line has no step:
  #   - python -m pip install gherkin-copilot
  #   - gherkin-copilot check features
  # and this `after_script` for an HTML report of every run, passed or failed:
  # after_script:
  #   - gherkin-copilot report reports/cucumber.json -o reports/report.html
  artifacts:
    when: always
    expire_in: 30 days
    # Traces record everything a scenario typed, passwords included (masking only hides them in the
    # job log), and the site's cookies: only project members with Developer role or above may
    # download them. Needs GitLab 16.11 or later; on older versions, delete this line.
    access: developer
    paths:
      - reports/
    reports:
      junit: reports/junit.xml  # results appear in the pipeline's Tests tab and in merge requests
