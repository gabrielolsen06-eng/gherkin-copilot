[pytest]
# Every scenario in features/ becomes a test (see tests/test_features.py)
bdd_features_base_dir = features
testpaths = tests
# The application under test. Steps can then use paths relative to it: page.goto("/login").
# Override it for one run with --base-url, or with the PYTEST_BASE_URL environment variable.
base_url =
# If a program on this machine starts the site (an .exe that runs a local server, say), name it here.
# It's started before the first scenario, and stopped with everything it started after the last;
# base_url is then where the site appears, e.g. http://localhost:8080. Output: reports/app_server.log
app_server =
# What to put after the program's name when starting it, separated by spaces
app_server_args =
# How many seconds it may take until base_url answers
app_server_wait = 300
